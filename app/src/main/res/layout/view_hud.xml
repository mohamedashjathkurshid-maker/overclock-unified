
<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content" android:layout_height="wrap_content"
    android:orientation="vertical" android:background="@drawable/bg_hud"
    android:padding="14dp">

    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="HUD//OVERCLOCK" android:textColor="@color/dim"
        android:fontFamily="monospace" android:textSize="10sp" />

    <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:orientation="horizontal" android:layout_marginTop="6dp">

        <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:orientation="vertical" android:layout_marginEnd="14dp">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="CPU" android:textColor="@color/dim" android:textSize="9sp" />
            <ProgressBar android:id="@+id/cpuBar" style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="90dp" android:layout_height="8dp"
                android:max="100" android:progressTint="@color/neon"
                android:progressBackgroundTint="@color/panel" />
            <TextView android:id="@+id/cpuText" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:text="0%"
                android:textColor="@color/neon" android:textSize="10sp" />
        </LinearLayout>

        <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:orientation="vertical" android:layout_marginEnd="14dp">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="RAM" android:textColor="@color/dim" android:textSize="9sp" />
            <ProgressBar android:id="@+id/ramBar" style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="90dp" android:layout_height="8dp"
                android:max="100" android:progressTint="@color/cyan"
                android:progressBackgroundTint="@color/panel" />
            <TextView android:id="@+id/ramText" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:text="0%"
                android:textColor="@color/cyan" android:textSize="10sp" />
        </LinearLayout>

        <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:orientation="vertical" android:layout_marginEnd="14dp">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="NET" android:textColor="@color/dim" android:textSize="9sp" />
            <TextView android:id="@+id/netText" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:text="0K"
                android:textColor="@color/purple" android:textSize="14sp"
                android:layout_marginTop="6dp" />
        </LinearLayout>

        <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:orientation="vertical">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="°C" android:textColor="@color/dim" android:textSize="9sp" />
            <TextView android:id="@+id/tempText" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:text="--"
                android:textColor="@color/amber" android:textSize="18sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <TextView android:id="@+id/fpsText" android:layout_width="wrap_content"
        android:layout_height="wrap_content" android:text="fps:--"
        android:textColor="@color/dimGreen" android:textSize="10sp"
        android:fontFamily="monospace" android:layout_marginTop="6dp" />
</LinearLayout>
