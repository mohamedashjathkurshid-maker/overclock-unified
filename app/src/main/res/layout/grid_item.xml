
<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="vertical" android:gravity="center"
    android:background="@drawable/bg_icon" android:padding="8dp">

    <ImageView android:id="@+id/appIcon" android:layout_width="44dp"
        android:layout_height="44dp" />
    <TextView android:id="@+id/appLabel" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:gravity="center"
        android:textColor="@color/txt" android:textSize="10sp"
        android:maxLines="1" android:ellipsize="end" android:layout_marginTop="4dp" />
</LinearLayout>
