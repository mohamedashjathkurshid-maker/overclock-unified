
<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="340dp" android:layout_height="wrap_content"
    android:orientation="vertical" android:background="@drawable/bg_console"
    android:padding="10dp">

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal">
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="root@a12:~$" android:textColor="@color/neon"
            android:fontFamily="monospace" android:textSize="13sp"
            android:layout_marginEnd="8dp" />
        <EditText android:id="@+id/consoleInput" android:layout_width="0dp"
            android:layout_height="wrap_content" android:layout_weight="1"
            android:hint="command_" android:textColor="@color/txt"
            android:textColorHint="@color/dim" android:background="@null"
            android:fontFamily="monospace" android:textSize="13sp"
            android:singleLine="true"
            android:imeOptions="actionGo" />
    </LinearLayout>

    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="[tap HUD] boost  ·  [hold] kill-all  ·  type help"
        android:textColor="@color/dim" android:textSize="9sp"
        android:fontFamily="monospace" android:layout_marginTop="4dp" />
</LinearLayout>
